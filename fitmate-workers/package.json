{
  "name": "fitmate-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --local --persist",
    "build": "tsc",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "deploy:staging": "wrangler deploy --env staging",
    "d1:create": "wrangler d1 create fitmate-db",
    "d1:create:prod": "wrangler d1 create fitmate-db-prod --env production",
    "d1:create:staging": "wrangler d1 create fitmate-db-staging --env staging",
    "d1:migrate": "wrangler d1 migrations apply fitmate-db --local",
    "d1:migrate:prod": "wrangler d1 migrations apply fitmate-db-prod --env production",
    "d1:migrate:staging": "wrangler d1 migrations apply fitmate-db-staging --env staging",
    "d1:studio": "wrangler d1 info fitmate-db --local",
    "type-check": "tsc --noEmit",
    "lint": "echo 'Linting not configured yet'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "@hono/zod-validator": "^0.2.0",
    "zod": "^3.23.0",
    "drizzle-orm": "^0.30.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.0.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "wrangler": "^3.0.0",
    "typescript": "^5.4.0",
    "@cloudflare/workers-types": "^4.0.0",
    "drizzle-kit": "^0.20.0",
    "@types/node": "^20.12.0",
    "vitest": "^1.0.0"
  }
}
