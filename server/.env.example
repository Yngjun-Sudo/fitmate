# 服务端口
PORT=3001

# JWT 密钥（生产环境请使用强随机字符串）
JWT_SECRET=fitness-app-jwt-secret-change-in-production

# DeepSeek API 配置
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 数据库
# 本地开发（SQLite）
DATABASE_URL="file:./dev.db"
# Render 部署（PostgreSQL）：取消注释并替换为实际连接串
# DATABASE_URL="postgresql://user:password@host:5432/fitmate?schema=public"
