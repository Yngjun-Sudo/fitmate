{
  "name": "fitmate-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc",
    "deploy": "npm run build && wrangler deploy",
    "d1:create": "wrangler d1 create fitmate-db",
    "d1:execute": "wrangler d1 execute fitmate-db --local --file",
    "d1:migrate": "wrangler d1 migrations apply fitmate-db --local",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.2.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.30.0",
    "hono": "^4.0.0",
    "jose": "^5.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260530.1",
    "@types/node": "^20.19.41",
    "drizzle-kit": "^0.20.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0",
    "wrangler": "^3.0.0"
  }
}
