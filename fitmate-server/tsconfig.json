{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "./",
    "lib": ["ES2022"],
    "isolatedModules": true,
    "noEmit": false
  },
  "include": ["src/**/*.ts", "d1/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
